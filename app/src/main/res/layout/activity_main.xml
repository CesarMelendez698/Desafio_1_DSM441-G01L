<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tarjeta contenedora para darle profundidad y orden -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:drawable/dialog_holo_light_frame"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Icono o Emoji ilustrativo superior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="56sp"
            android:layout_marginBottom="16dp" />

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="¡Bienvenido a Mi Perfil!"
            android:textColor="#212529"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo descriptivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Gestiona y registra tu información personal de forma rápida y segura."
            android:textColor="#6C757D"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Botón de acción estilizado -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#0D6EFD"
            android:text="Iniciar"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>